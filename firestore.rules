rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with ADMIN_EMAILS in index.html. email_verified stops someone
    // signing up with an admin address they don't own.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['johnchutton@gmail.com'];
    }

    // Shape checks for listings written by farmers. These values are rendered
    // into the page, so they must be the types the app expects.
    function validListing(d) {
      return d.price is number && d.price > 0
        && (d.get('wt', null) == null || d.wt is number)
        && (d.get('qty', null) == null || (d.qty is int && d.qty >= 2))
        && (d.get('img', null) == null
            || d.img.matches('https://firebasestorage[.]googleapis[.]com/.*'));
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'live'
        || (request.auth != null && request.auth.uid == resource.data.ownerUid)
        || isAdmin();
      // Admins may create listings in any status (used by "Load demo data").
      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && validListing(request.resource.data));
      allow update, delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.status == resource.data.status
            && validListing(request.resource.data));
    }

    match /events/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /venues/{id}  { allow read: if true; allow write: if isAdmin(); }
  }
}
